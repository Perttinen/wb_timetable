{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "outDir": "./build/backend",
    "types": ["jest"],
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "backend/**/*.ts",
    "tests/**/*.test.ts",
    "database/**/*.ts",
    "index.ts"
  ]
}
