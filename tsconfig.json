{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "outDir": "build",
    "types": ["jest"],
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "lib": ["esnext"]
  },
  "include": [
    "backend/**/*.ts",
    "tests/**/*.test.ts",
    "database/**/*.ts",
    "index.ts",
    "tests/api.tese.ts"
  ]
}
